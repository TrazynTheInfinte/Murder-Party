# copies whatever the admin staged (any count, up to a container's 27
# slots) from the staging container into the Saboteur's main inventory -
# empty slots copy harmlessly as a no-op
execute at @e[tag=mp_saboteur_kit,limit=1] run item replace entity @s inventory.0 from block ~ ~ ~ container.0
