tellraw @s [{"text":"[Murder Party] Setup commands:","color":"gold","bold":true}]
tellraw @s [{"text":"admin/set_lobby_point","color":"yellow"},{"text":" - stand where players should wait before/after a Round, run this - shared across every Map","color":"gray"}]
tellraw @s [{"text":"Every other setup command below is per-Map - only Map 1 exists so far, so they all live under admin/map1/","color":"gray"}]
tellraw @s [{"text":"admin/map1/add_spawn_point","color":"yellow"},{"text":" - stand where a Participant may be placed at Round start, run once per spot (at least 1 needed)","color":"gray"}]
tellraw @s [{"text":"admin/map1/clear_spawn_points","color":"yellow"},{"text":" - removes all of Map 1's spawn points, so you can redo them","color":"gray"}]
tellraw @s [{"text":"admin/map1/set_meeting_point","color":"yellow"},{"text":" - stand near an already-placed Panic Button, run this to link it as Map 1's Meeting Point","color":"gray"}]
tellraw @s [{"text":"admin/map1/set_security_room","color":"yellow"},{"text":" - stand near a chest/barrel with the bound Camera Monitor in its first slot, run this to link it as Map 1's Security Room","color":"gray"}]
tellraw @s [{"text":"/scoreboard players set #map1 mp_security_radius <N>","color":"yellow"},{"text":" - sets how far the Monitor can travel from Map 1's Security Room before it's returned (default 15)","color":"gray"}]
tellraw @s [{"text":"admin/map1/set_saboteur_kit","color":"yellow"},{"text":" - stand near a chest/barrel of bound Create remotes, run this to link it as Map 1's Saboteur starting kit","color":"gray"}]
tellraw @s [{"text":"admin/force_start","color":"yellow"},{"text":" - starts a Round immediately, bypassing the 3-player join threshold","color":"gray"}]
tellraw @s [{"text":"admin/force_stop","color":"yellow"},{"text":" - cancels the current Round, countdown, or Meeting","color":"gray"}]
tellraw @s [{"text":"admin/toggle_force_neutral","color":"yellow"},{"text":" - debug only: lets a 3-player Round roll a Neutral Role, which otherwise needs 4+","color":"gray"}]
